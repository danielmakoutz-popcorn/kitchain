# Copy the settings you need into backend/.env; keep your existing DB_URL.
# These are backend settings. Do not put this key in app/.env or EXPO_PUBLIC_*.
TAVILY_API_KEY=
SEARCH_MONTHLY_CREDITS=1000
SEARCH_DAILY_PER_MEMBER=20
SEARCH_MAX_PAGES=3

# A separate text model; the photo scanner still uses qwen2.5vl:3b.
TEXT_AI_ENABLED=true
TEXT_AI_URL=http://127.0.0.1:11434
TEXT_AI_MODEL=qwen3:4b
TEXT_AI_TIMEOUT=45

# Comma-separated exact hostnames with separately verified permission to store
# and republish their recipe text. Leave empty otherwise. Links still work.
RECIPE_REUSE_DOMAINS=
